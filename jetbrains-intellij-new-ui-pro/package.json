{
  "name": "jetbrains-intellij-new-ui-pro",
  "publisher": "elaand",
  "displayName": "IntelliJ IDEA New UI (Pro)",
  "description": "All-in-one IntelliJ IDEA New UI (Dark & Light) experience for Antigravity IDE: official ExperimentalDark & ExperimentalLight workbench palettes, deep Java/Spring & TypeScript semantic highlighting, JetBrains expui File Icons, Product UI Icons, JetBrains Mono typography, and toggleable IntelliJ Keymap.",
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Keymaps"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "title": "IntelliJ IDEA New UI (Pro)",
      "properties": {
        "intellijNewUi.enableKeymap": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 1,
          "description": "Bật/tắt bộ phím tắt chuẩn IntelliJ IDEA (Windows) ngay lập tức mà không cần khởi động lại IDE."
        },
        "intellijNewUi.onlyApplyInJavaProjects": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 2,
          "description": "Chỉ áp dụng giao diện, bộ biểu tượng và phím tắt IntelliJ IDEA khi mở dự án Java (có pom.xml, build.gradle hoặc file .java)."
        }
      }
    },
    "commands": [
      {
        "command": "intellijNewUi.applySettings",
        "title": "IntelliJ New UI: Apply Recommended IDE Settings & Layout"
      },
      {
        "command": "intellijNewUi.restoreSettings",
        "title": "IntelliJ New UI: Restore Previous IDE Settings"
      },
      {
        "command": "intellijNewUi.toggleKeymap",
        "title": "IntelliJ New UI: Toggle IntelliJ Keymap (On/Off)"
      }
    ],
    "themes": [
      {
        "id": "IntelliJ IDEA New UI Dark (Pro)",
        "label": "IntelliJ IDEA New UI Dark (Pro)",
        "uiTheme": "vs-dark",
        "path": "./themes/intellij-new-ui-dark-pro.json"
      },
      {
        "id": "IntelliJ IDEA New UI Light (Pro)",
        "label": "IntelliJ IDEA New UI Light (Pro)",
        "uiTheme": "vs",
        "path": "./themes/intellij-new-ui-light-pro.json"
      }
    ],
    "iconThemes": [
      {
        "id": "intellij-new-ui-file-icons",
        "label": "IntelliJ IDEA New UI File Icons",
        "path": "./icons/file-icons/intellij-new-ui-file-icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "intellij-new-ui-product-icons",
        "label": "IntelliJ IDEA New UI Product Icons",
        "path": "./icons/product-icons/intellij-new-ui-product-icons.json"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+a",
        "command": "workbench.action.showCommands",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+n",
        "command": "workbench.action.quickOpen",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+n",
        "command": "workbench.action.quickOpen",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+alt+n",
        "command": "workbench.action.showAllSymbols",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+f",
        "command": "workbench.action.findInFiles",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+r",
        "command": "workbench.action.replaceInFiles",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+e",
        "command": "workbench.action.openPreviousRecentlyUsedEditorInGroup",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+e",
        "command": "workbench.action.showAllEditorsByMostRecentlyUsed",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+f12",
        "command": "workbench.action.gotoSymbol",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+g",
        "command": "workbench.action.gotoLine",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+b",
        "command": "editor.action.revealDefinition",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasDefinitionProvider && editorTextFocus"
      },
      {
        "key": "ctrl+alt+b",
        "command": "editor.action.goToImplementation",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasImplementationProvider && editorTextFocus"
      },
      {
        "key": "ctrl+shift+b",
        "command": "editor.action.goToTypeDefinition",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "alt+f7",
        "command": "editor.action.referenceSearch.trigger",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasReferenceProvider && editorTextFocus"
      },
      {
        "key": "ctrl+alt+left",
        "command": "workbench.action.navigateBack",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+alt+right",
        "command": "workbench.action.navigateForward",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+shift+backspace",
        "command": "workbench.action.navigateToLastEditLocation",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "alt+enter",
        "command": "editor.action.quickFix",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasCodeActionsProvider && editorTextFocus"
      },
      {
        "key": "ctrl+d",
        "command": "editor.action.copyLinesDownAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+y",
        "command": "editor.action.deleteLines",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+w",
        "command": "editor.action.smartSelect.expand",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+shift+w",
        "command": "editor.action.smartSelect.shrink",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+alt+l",
        "command": "editor.action.formatDocument",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+alt+o",
        "command": "editor.action.organizeImports",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+/",
        "command": "editor.action.commentLine",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+shift+/",
        "command": "editor.action.blockComment",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+alt+up",
        "command": "editor.action.moveLinesUpAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+alt+down",
        "command": "editor.action.moveLinesDownAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+shift+u",
        "command": "editor.action.transformToUppercase",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+f6",
        "command": "editor.action.rename",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorHasRenameProvider && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+alt+m",
        "command": "editor.action.codeAction",
        "args": {
          "kind": "refactor.extract.function"
        },
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+alt+v",
        "command": "editor.action.codeAction",
        "args": {
          "kind": "refactor.extract.constant"
        },
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+f10",
        "command": "workbench.action.debug.run",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "shift+f9",
        "command": "workbench.action.debug.start",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "ctrl+f2",
        "command": "workbench.action.debug.stop",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && inDebugMode"
      },
      {
        "key": "f8",
        "command": "workbench.action.debug.stepOver",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && debugState == 'stopped'"
      },
      {
        "key": "f7",
        "command": "workbench.action.debug.stepInto",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && debugState == 'stopped'"
      },
      {
        "key": "shift+f8",
        "command": "workbench.action.debug.stepOut",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && debugState == 'stopped'"
      },
      {
        "key": "f9",
        "command": "workbench.action.debug.continue",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && debugState == 'stopped'"
      },
      {
        "key": "ctrl+f8",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "alt+1",
        "command": "workbench.view.explorer",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "alt+f12",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "alt+9",
        "command": "workbench.view.scm",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "f2",
        "command": "editor.action.marker.next",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "shift+f2",
        "command": "editor.action.marker.prev",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+f4",
        "command": "workbench.action.closeActiveEditor",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow"
      },
      {
        "key": "alt+insert",
        "command": "editor.action.sourceAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+alt+t",
        "command": "editor.action.refactor",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+shift+up",
        "command": "editor.action.moveLinesUpAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+shift+down",
        "command": "editor.action.moveLinesDownAction",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+h",
        "command": "editor.action.showTypeHierarchy",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+alt+h",
        "command": "editor.action.showCallHierarchy",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+p",
        "command": "editor.action.triggerParameterHints",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      },
      {
        "key": "ctrl+q",
        "command": "editor.action.showHover",
        "when": "config.intellijNewUi.enableKeymap && !intellijNewUi.disabledInThisWindow && editorTextFocus"
      }
    ]
  },
  "keywords": [
    "jetbrains",
    "intellij",
    "new-ui",
    "dark",
    "light",
    "darcula",
    "icons",
    "product-icons",
    "keymap",
    "java",
    "spring"
  ]
}
